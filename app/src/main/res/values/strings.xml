<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">拼写自律锁</string>
    <string name="service_label">拼写自律锁 · 前台应用检测</string>
    <string name="accessibility_service_description">用于识别哔哩哔哩、抖音等目标应用是否被打开。检测到目标应用时会立刻弹出全屏验证页，答对 10 个考研核心词才能继续使用；验证通过后 5 分钟内不重复拦截，三款目标应用累计使用满 20 分钟会再测一次。本服务不读取窗口内容，也不会上传任何数据。</string>

    <string name="verify_title">先答对 10 个考研核心词</string>
    <string name="verify_subtitle">下面的中文释义来自考研英语核心词汇，请输入对应的英文单词（忽略大小写）。</string>
    <string name="verify_button">验证并继续</string>
    <string name="verify_footnote">没有跳过按钮。全部答对才会关闭本页；验证通过后 5 分钟内不重复拦截，三款应用累计使用满 20 分钟会再测一次。</string>
    <string name="spell_error">拼写错误，请重试</string>
    <string name="loading_words">正在加载考研词表…</string>
    <string name="retry_load">重新加载词表</string>
    <string name="back_to_home">回到桌面（不会解除限制）</string>
