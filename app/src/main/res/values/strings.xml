    <string name="mnemonic_prefix">巧记：</string>
    <string name="choice_title">第一步：选出正确的中文释义</string>
    <string name="choice_hint">选错的单词，第二步要亲手拼出来</string>
    <string name="spelling_title">第二步：拼写刚才选错的单词</string>
