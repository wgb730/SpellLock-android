<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 降级方案：后台启动 Activity 被限制时，用高优先级通知（带全屏 Intent）提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 11+ 包可见性：用于「包名检测」页，以及 Launcher / 输入法过滤 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".SpellLockApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpellLock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 选择要拦截的应用：列出全部可启动应用，勾选后写进 ExtraTargets -->
        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="选择要拦截的应用" />

        <!--
            验证页：
            - exported=false：只能由本 App 内部启动
            - excludeFromRecents=true：不出现在最近任务里
            - taskAffinity 为空：独占一个任务栈，验证完成后 finishAndRemoveTask 不会把目标 App 顶掉
            - launchMode=singleTask：避免服务连续触发时叠出多个验证页
        -->
        <activity
            android:name=".SpellCheckActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.SpellLock.Fullscreen"
            android:windowSoftInputMode="adjustResize" />

        <!-- 无障碍服务：主方案的前台 App 感知入口 -->
        <service
            android:name=".AppAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>

</manifest>
