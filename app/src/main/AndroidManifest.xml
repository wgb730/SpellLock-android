<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 降级方案：后台启动 Activity 被限制时，用高优先级通知（带全屏 Intent）提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 守护服务：常驻前台通知，降低被国产 ROM 内存回收杀掉的概率 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        自动恢复无障碍：系统 force-stop 本应用后会把本服务从 enabled_accessibility_services 删掉。
        有了这个权限（用户用 adb 一次性授权：pm grant com.detox.spelllock android.permission.WRITE_SECURE_SETTINGS），
        守护服务就能自己写回去，用户无感；没授权则退化成"发通知让用户点一下"。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ 包可见性：用于「包名检测」页，以及 Launcher / 输入法过滤 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".SpellLockApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpellLock">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 选择要拦截的应用：列出全部可启动应用，勾选后写进 ExtraTargets -->
        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="选择要拦截的应用" />

        <!-- 错词本：主页入口，只在本应用内打开 -->
        <activity
            android:name=".WrongBookActivity"
            android:exported="false"
            android:label="@string/wrong_title" />

        <!--
            验证页：
            - exported=false：只能由本 App 内部启动
            - excludeFromRecents=true：不出现在最近任务里
            - taskAffinity 为空：独占一个任务栈，验证完成后 finishAndRemoveTask 不会把目标 App 顶掉
            - launchMode=singleTask：避免服务连续触发时叠出多个验证页
        -->
        <activity
            android:name=".SpellCheckActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.SpellLock.Fullscreen"
            android:windowSoftInputMode="adjustResize" />

        <!-- 无障碍服务：主方案的前台 App 感知入口 -->
        <service
            android:name=".AppAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- 守护服务：常驻通知 + 每 20 秒检查无障碍是否被系统关掉 -->
        <service
            android:name=".GuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep accessibility guard alive so the app lock keeps working" />
        </service>

        <!-- 开机自启：重启后自动把守护服务与无障碍服务拉起来 -->
        <!-- 看门狗：每 5 分钟醒一次，进程被杀后把守护服务与无障碍服务拉回来 -->
        <receiver
            android:name=".GuardAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
